+#[test]
+fn large_frames_preserve_modes_with_arbitrary_chunk_boundaries() {
+    for chunk_size in [1, 7, 2048, 4096, 16384] {
+        let mut session = TerminalSession::new(TerminalConfig::default()).unwrap();
+        assert!(session.cursor_visible());
+        for enabled in [true, false] {
+            let command = if enabled { 'h' } else { 'l' };
+            let mut output = format!("\x1b[?1000;1002;1003;1006;2004{command}").into_bytes();
+            output.extend_from_slice(b"\x1b[?25l");
+            output.extend_from_slice(&vec![b' '; 8192]);
+            for chunk in output.chunks(chunk_size) {
+                session.feed(chunk).unwrap();
+            }
+            assert_eq!(session.mouse_reporting_enabled(), enabled);
+            assert_eq!(session.mouse_sgr_enabled(), enabled);
+            assert_eq!(session.mouse_any_event_enabled(), enabled);
+            assert_eq!(session.bracketed_paste_enabled(), enabled);
+            assert!(!session.cursor_visible());
+        }
+        session.feed(b"\x1b[?25h").unwrap();
+        assert!(session.cursor_visible());
+    }
