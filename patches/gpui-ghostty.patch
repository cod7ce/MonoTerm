+#[test]
+fn scrolling_retains_negative_viewport_coordinates() {
+    let mut t = terminal();
+    t.feed(b"\x1b_Ga=T,f=32,i=1,s=1,v=1,c=2,r=3,C=1;/wAA/w==\x1b\\\x1b[6;1H\n\n")
+        .unwrap();
+    let p = t.images().unwrap().remove(0);
+    assert_eq!(p.viewport_row, -2);
+    assert_eq!((p.width, p.height), (20, 60));
+}
+
+#[test]
+fn reset_and_screen_switches_never_reuse_payload_identity() {
+    let mut t = terminal();
+    t.feed(RED).unwrap();
+    let original = t.images().unwrap().remove(0);
+    t.feed(b"\x1b[?1049h").unwrap();
+    t.feed(b"\x1b_Ga=T,f=32,i=1,s=1,v=1,C=1;AAD//w==\x1b\\")
+        .unwrap();
+    let alt = t.images().unwrap().remove(0);
+    assert_ne!(original.generation, alt.generation);
+    assert_eq!(alt.image.rgba, [0, 0, 255, 255]);
+    t.feed(b"\x1b[?1049l\x1bc").unwrap();
+    t.feed(RED).unwrap();
+    assert_ne!(original.generation, t.images().unwrap()[0].generation);
+}
