+use std::time::{Duration, Instant};
+
+/// Copy and free an adapter-owned byte buffer. `None` means the call failed;
+/// an allocated zero-length buffer becomes `Some(Vec::new())`.
+fn take_bytes(bytes: ghostty_vt_sys::ghostty_vt_bytes_t) -> Option<Vec<u8>> {
+    if bytes.ptr.is_null() {
+        return None;
+    }
+    let out = if bytes.len == 0 {
+        Vec::new()
+    } else {
+        unsafe { std::slice::from_raw_parts(bytes.ptr, bytes.len) }.to_vec()
+    };
+    unsafe { ghostty_vt_sys::ghostty_vt_bytes_free(bytes) };
+    Some(out)
+}
 
