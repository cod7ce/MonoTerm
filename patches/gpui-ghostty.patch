+    fn copy_image(&self, id: u32) -> Result<Option<(u64, Arc<ImageData>)>, Error> {
+        let (mut width, mut height, mut format, mut len) = (0u32, 0u32, 0i32, 0usize);
+        let mut data = std::ptr::null();
