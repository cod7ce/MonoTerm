+
+#[repr(C)]
+struct SysImage {
+    width: u32,
+    height: u32,
+    data: *mut u8,
+    data_len: usize,
+}
+
+/// Install the process-global decoder once, before any terminal is created.
+pub fn init() {
+    static INIT: std::sync::Once = std::sync::Once::new();
+    INIT.call_once(|| unsafe {
+        assert_eq!(
+            ghostty_sys_set(1, decode_png as *const core::ffi::c_void),
+            0
+        );
+    });
+}
+
+unsafe extern "C" fn decode_png(
+    _userdata: *mut core::ffi::c_void,
+    allocator: *const core::ffi::c_void,
+    data: *const u8,
+    len: usize,
+    out: *mut SysImage,
+) -> bool {
+    // No panic or Rust-owned allocation may cross the C ownership boundary.
+    std::panic::catch_unwind(|| unsafe { decode_png_inner(allocator, data, len, out) })
+        .unwrap_or(false)
+}
+
+unsafe fn decode_png_inner(
+    allocator: *const core::ffi::c_void,
+    data: *const u8,
+    len: usize,
+    out: *mut SysImage,
+) -> bool {
+    use image::ImageDecoder;
+    if data.is_null() || out.is_null() || len == 0 || len > MAX_IMAGE_BYTES {
+        return false;
+    }
+    let mut limits = image::Limits::default();
+    limits.max_alloc = Some(MAX_IMAGE_BYTES as u64);
+    let input = unsafe { std::slice::from_raw_parts(data, len) };
+    let Ok(decoder) =
+        image::codecs::png::PngDecoder::with_limits(std::io::Cursor::new(input), limits)
+    else {
+        return false;
+    };
+    let (width, height) = decoder.dimensions();
+    let Some(size) = (width as usize)
+        .checked_mul(height as usize)
+        .and_then(|n| n.checked_mul(4))
+    else {
+        return false;
+    };
+    if size == 0 || size > MAX_IMAGE_BYTES || decoder.total_bytes() > MAX_IMAGE_BYTES as u64 {
+        return false;
+    }
+    let Ok(decoded) = image::DynamicImage::from_decoder(decoder) else {
+        return false;
+    };
+    let pixels = decoded.into_rgba8().into_raw();
+    if pixels.len() != size {
+        return false;
+    }
+    let owned = unsafe { ghostty_alloc(allocator, size) };
+    if owned.is_null() {
+        return false;
+    }
+    unsafe {
+        std::ptr::copy_nonoverlapping(pixels.as_ptr(), owned, size);
+        *out = SysImage {
+            width,
+            height,
+            data: owned,
+            data_len: size,
+        };
+    }
+    true
+}
 
