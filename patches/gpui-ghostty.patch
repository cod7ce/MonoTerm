+                id,
+                &mut width,
+                &mut height,
+                &mut format,
+                &mut data,
+                &mut len,
+            )
+        };
+        // Pending chunked data may become available without changing generation.
+        if rc == -4 {
+            return Ok(None);
+        }
+        if rc != 0 || data.is_null() {
+            return Err(Error::DumpFailed);
+        }
+        let channels = match format {
+            0 => 3,
+            1 => 4,
+            3 => 2,
+            4 => 1,
+            _ => return Ok(None),
+        };
+        let pixels = (width as usize)
+            .checked_mul(height as usize)
+            .ok_or(Error::DumpFailed)?;
+        let size = pixels.checked_mul(4).ok_or(Error::DumpFailed)?;
+        if size == 0
+            || size > ghostty_vt_sys::MAX_IMAGE_BYTES
+            || pixels.checked_mul(channels) != Some(len)
+        {
+            return Ok(None);
+        }
+        let source = unsafe { std::slice::from_raw_parts(data, len) };
+        let mut rgba = Vec::with_capacity(size);
+        for pixel in source.chunks_exact(channels) {
+            match channels {
+                4 => rgba.extend_from_slice(pixel),
+                3 => rgba.extend_from_slice(&[pixel[0], pixel[1], pixel[2], 255]),
+                2 => rgba.extend_from_slice(&[pixel[0], pixel[0], pixel[0], pixel[1]]),
+                1 => rgba.extend_from_slice(&[pixel[0], pixel[0], pixel[0], 255]),
+                _ => unreachable!(),
+            }
+        }
+        static GENERATION: AtomicU64 = AtomicU64::new(1);
+        Ok(Some((
+            GENERATION.fetch_add(1, Ordering::Relaxed),
+            Arc::new(ImageData {
+                width,
+                height,
+                rgba,
+            }),
+        )))
+    }
+}
