+#[test]
+fn hold_captures_text_and_images_at_exact_parser_boundary() {
+    let mut t = terminal();
+    t.feed(RED).unwrap();
+    t.feed(b"before\x1b[?2026h\rAFTER!\x1b_Ga=d,d=A\x1b\\")
+        .unwrap();
+    t.tick().unwrap();
+    assert_eq!(t.dump_viewport_row(0).unwrap(), "before");
+    assert_eq!(t.images().unwrap()[0].image.rgba, [255, 0, 0, 255]);
+    let deadline = t.next_render_deadline().unwrap();
+    assert_eq!(Some(deadline), t.next_render_deadline());
+    assert!(deadline <= Instant::now() + Duration::from_millis(1500));
+    t.set_cell_size(10, 20).unwrap();
+    t.resize(12, 6).unwrap();
+    assert_eq!(t.dump_viewport_row(0).unwrap(), "before");
+    t.feed(b"\x1b[?2026l").unwrap();
+    t.tick().unwrap();
+    assert_eq!(t.dump_viewport_row(0).unwrap(), "AFTER!");
+    assert!(t.images().unwrap().is_empty());
+    assert!(t.next_render_deadline().is_none());
+}
+
+#[test]
+fn hold_timeout_releases_and_resets_mode() {
+    let mut t = terminal();
+    t.feed(b"old\x1b[?2026h\rnew").unwrap();
+    std::thread::sleep(Duration::from_millis(1020));
+    t.tick().unwrap();
+    assert_eq!(t.dump_viewport_row(0).unwrap(), "new");
+    assert!(t.next_render_deadline().is_none());
+    t.feed(b"\x1b[?2026h\rEND").unwrap();
+    assert!(t.next_render_deadline().is_some());
+    assert_eq!(t.dump_viewport_row(0).unwrap(), "new");
+}
+
+#[test]
+fn animation_changes_pixels_and_schedules_without_pty_output() {
+    let mut t = terminal();
+    t.feed(RED).unwrap();
+    t.feed(b"\x1b_Ga=f,f=32,i=1,s=1,v=1,z=40;AAD//w==\x1b\\\x1b_Ga=a,i=1,r=1,z=30\x1b\\\x1b_Ga=a,i=1,s=3\x1b\\").unwrap();
+    t.tick().unwrap();
+    let first = t.images().unwrap().remove(0);
+    assert_eq!(first.image.rgba, [255, 0, 0, 255]);
+    assert!(t.next_render_deadline().is_some());
+    std::thread::sleep(Duration::from_millis(35));
+    t.tick().unwrap();
+    let second = t.images().unwrap().remove(0);
+    assert_eq!(second.image.rgba, [0, 0, 255, 255]);
+    assert_ne!(first.generation, second.generation);
+    t.feed(b"\x1b_Ga=a,i=1,s=1\x1b\\").unwrap();
+    t.tick().unwrap();
+    assert!(t.next_render_deadline().is_none());
+}
+
+#[test]
+fn response_parser_handles_split_queries_and_configured_colors() {
+    let mut t = terminal();
+    t.set_default_colors(Rgb { r: 1, g: 2, b: 3 }, Rgb { r: 4, g: 5, b: 6 });
+    t.feed(b"\x1b[").unwrap();
+    assert!(t.take_responses().is_empty());
+    t.feed(b"c\x1b[2;3H\x1b[6n\x1b]10;?\x07\x1b]11;?\x07")
+        .unwrap();
+    let response = String::from_utf8(t.take_responses()).unwrap();
+    assert!(response.starts_with("\x1b[?1;2c\x1b[2;3R"));
+    assert!(response.contains("rgb:0101/0202/0303"), "{response:?}");
+    assert!(response.contains("rgb:0404/0505/0606"), "{response:?}");
+    assert!(t.take_responses().is_empty());
+
+    t.feed(b"\x1b[>c\x1b[=c").unwrap();
+    let response = String::from_utf8(t.take_responses()).unwrap();
+    assert_eq!(response, "\x1b[>1;140;0c\x1bP!|00000000\x1b\\");
+}
+
+#[test]
+fn tick_and_images_do_not_mark_dirty_rows_clean() {
+    let mut t = terminal();
+    assert_eq!(
+        t.take_dirty_viewport_rows(6).unwrap(),
+        vec![0, 1, 2, 3, 4, 5]
+    );
+    t.feed(b"hello").unwrap();
+    t.tick().unwrap();
+    assert_eq!(t.take_dirty_viewport_rows(6).unwrap(), vec![0]);
+
+    t.feed(b"\x1b[2;1Hx").unwrap();
+    t.images().unwrap();
+    assert!(t.take_dirty_viewport_rows(6).unwrap().contains(&1));
+}
+
+#[test]
+fn explicit_background_has_distinct_style_flag() {
+    let mut t = terminal();
+    t.feed(b"A\x1b[48;2;0;0;0mB\x1b[0mC").unwrap();
+    let cells = t.dump_viewport_row_cell_styles(0).unwrap();
+    assert_eq!(cells[0].bg, cells[1].bg);
+    assert_eq!(cells[0].flags & 128, 0);
+    assert_eq!(cells[1].flags & 128, 128);
+    assert_eq!(cells[2].flags & 128, 0);
+}
diff --git a/crates/ghostty_vt/tests/terminal_state.rs b/crates/ghostty_vt/tests/terminal_state.rs
new file mode 100644
index 0000000..a1cef4b
--- /dev/null
+++ b/crates/ghostty_vt/tests/terminal_state.rs
@@ -0,0 +1,23 @@
+use ghostty_vt::Terminal;
+
+#[test]
+fn title_and_private_modes_come_from_parsed_terminal_state() {
+    let mut t = Terminal::new(20, 4).unwrap();
+    assert_eq!(t.title(), None);
+    t.feed(b"\x1b]2;build logs\x07\x1b[?25l\x1b[?1000h\x1b[?1006h\x1b[?2004h")
+        .unwrap();
+
+    assert_eq!(t.title().as_deref(), Some("build logs"));
+    assert_eq!(t.mode(25, false), Some(false));
+    assert_eq!(t.mode(1000, false), Some(true));
+    assert_eq!(t.mode(1006, false), Some(true));
+    assert_eq!(t.mode(2004, false), Some(true));
+    assert_eq!(t.mode(1002, false), Some(false));
+    assert_eq!(t.mode(4, true), Some(false));
+    assert_eq!(t.mouse_tracking(), Some(true));
+
+    t.feed(b"\x1b[?1000l\x1b[?25h\x1b]0;\x07").unwrap();
+    assert_eq!(t.mode(25, false), Some(true));
+    assert_eq!(t.mouse_tracking(), Some(false));
+    assert_eq!(t.title(), None);
+}
diff --git a/crates/ghostty_vt_sys/src/adapter.c b/crates/ghostty_vt_sys/src/adapter.c
new file mode 100644
index 0000000..09af307
--- /dev/null
+++ b/crates/ghostty_vt_sys/src/adapter.c
@@ -0,0 +1,507 @@
+#ifndef _POSIX_C_SOURCE
+#define _POSIX_C_SOURCE 200809L
+#endif
+
+#include "ghostty_vt.h"
+#include <ghostty/vt.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define IMAGE_LIMIT (64u * 1024u * 1024u)
+#define RESPONSE_LIMIT (1024u * 1024u)
+
+typedef struct {
+    uint8_t *ptr;
+    size_t len, cap;
+} Buffer;
+
+typedef struct {
+    GhosttyTerminal terminal;
+    GhosttyRenderState state;
+    GhosttyRenderStateRowIterator rows_iter;
+    GhosttyRenderStateRowCells cells_iter;
+    GhosttyRenderStateImageIterator images_iter;
+    uint16_t cols, rows, cursor_x, cursor_y;
+    uint32_t cell_width, cell_height;
+    bool needs_update, held, has_scroll;
+    uint64_t hold_deadline, animation_deadline, epoch, scroll_offset, previous_scroll;
+    Buffer responses;
+    ghostty_vt_capture_fn capture;
+    void *capture_userdata;
+} Terminal;
+
+static uint64_t monotonic_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+static bool append(Buffer *b, const void *src, size_t len) {
+    if (len > SIZE_MAX - b->len) return false;
+    size_t needed = b->len + len;
+    if (needed > b->cap) {
+        size_t cap = needed > b->cap * 2 ? needed : b->cap * 2;
+        if (cap < 64) cap = 64;
+        void *p = realloc(b->ptr, cap);
+        if (!p) return false;
+        b->ptr = p;
+        b->cap = cap;
+    }
+    if (len) memcpy(b->ptr + b->len, src, len);
+    b->len += len;
+    return true;
+}
+
+static ghostty_vt_bytes_t finish(Buffer b) {
+    if (!b.ptr) b.ptr = malloc(1);
+    return (ghostty_vt_bytes_t){b.ptr, b.len};
+}
+
+static ghostty_vt_bytes_t fail(Buffer b) {
+    free(b.ptr);
+    return (ghostty_vt_bytes_t){0};
+}
+
+static int update(Terminal *t) {
+    if (t->held || !t->needs_update) return GHOSTTY_SUCCESS;
+    GhosttyColorRgb old_fg = {0}, old_bg = {0}, new_fg = {0}, new_bg = {0};
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_COLOR_FOREGROUND, &old_fg);
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_COLOR_BACKGROUND, &old_bg);
+    int rc = ghostty_render_state_update(t->state, t->terminal);
+    if (rc) return rc;
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_COLOR_FOREGROUND, &new_fg);
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_COLOR_BACKGROUND, &new_bg);
+    if (memcmp(&old_fg, &new_fg, sizeof(old_fg)) || memcmp(&old_bg, &new_bg, sizeof(old_bg))) {
+        GhosttyRenderStateDirty dirty = GHOSTTY_RENDER_STATE_DIRTY_FULL;
+        ghostty_render_state_set(t->state, GHOSTTY_RENDER_STATE_OPTION_DIRTY, &dirty);
+    }
+    ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_CURSOR_X, &t->cursor_x);
+    ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_CURSOR_Y, &t->cursor_y);
+    GhosttyTerminalScrollbar bar = {0};
+    ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_SCROLLBAR, &bar);
+    t->scroll_offset = bar.offset;
+    t->needs_update = false;
+    return GHOSTTY_SUCCESS;
+}
+
+static void write_pty(GhosttyTerminal terminal, void *userdata, const uint8_t *data, size_t len) {
+    (void)terminal;
+    Terminal *t = userdata;
+    if (len <= RESPONSE_LIMIT - t->responses.len) append(&t->responses, data, len);
+}
+
+static bool device_attributes(GhosttyTerminal terminal, void *userdata, GhosttyDeviceAttributes *attrs) {
+    (void)terminal; (void)userdata;
+    memset(attrs, 0, sizeof(*attrs));
+    attrs->primary.conformance_level = 1;
+    attrs->primary.features[0] = 2;
+    attrs->primary.num_features = 1;
+    attrs->secondary.device_type = 1;
+    attrs->secondary.firmware_version = 140;
+    return true;
+}
+
+static void render_hold(GhosttyTerminal terminal, void *userdata, bool held) {
+    (void)terminal;
+    Terminal *t = userdata;
+    if (held) {
+        t->needs_update = true;
+        update(t);
+        /* Copy image payloads while they still belong to the captured frame. */
+        if (t->capture) t->capture(t->capture_userdata);
+        t->hold_deadline = monotonic_ms() + 1000;
+    } else {
+        t->hold_deadline = 0;
+        t->needs_update = true;
+    }
+    t->held = held;
+}
+
+static void reset(GhosttyTerminal terminal, void *userdata) {
+    (void)terminal;
+    Terminal *t = userdata;
+    t->epoch++;
+    t->needs_update = true;
+}
+
+void *ghostty_vt_terminal_new(uint16_t cols, uint16_t rows) {
+    if (!cols || !rows) return NULL;
+    Terminal *t = calloc(1, sizeof(*t));
+    if (!t) return NULL;
+    t->cols = cols; t->rows = rows;
+    t->cell_width = 8; t->cell_height = 16;
+    t->needs_update = true;
+    if (ghostty_terminal_new(NULL, &t->terminal, cols, rows) ||
+        ghostty_render_state_new(NULL, &t->state) ||
+        ghostty_render_state_row_iterator_new(NULL, &t->rows_iter) ||
+        ghostty_render_state_row_cells_new(NULL, &t->cells_iter) ||
+        ghostty_render_state_image_iterator_new(NULL, &t->images_iter)) {
+        ghostty_vt_terminal_free(t);
+        return NULL;
+    }
+    uint64_t limit = IMAGE_LIMIT;
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_USERDATA, t);
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_WRITE_PTY, write_pty);
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_DEVICE_ATTRIBUTES, device_attributes);
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_RENDER_HOLD, render_hold);
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_RESET, reset);
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_STORAGE_LIMIT, &limit);
+    ghostty_vt_terminal_set_default_colors(t, 255, 255, 255, 0, 0, 0);
+    ghostty_terminal_resize(t->terminal, cols, rows, t->cell_width, t->cell_height);
+    return t;
+}
+
+void ghostty_vt_terminal_free(void *ptr) {
+    Terminal *t = ptr;
+    if (!t) return;
+    ghostty_render_state_image_iterator_free(t->images_iter);
+    ghostty_render_state_row_cells_free(t->cells_iter);
+    ghostty_render_state_row_iterator_free(t->rows_iter);
+    ghostty_render_state_free(t->state);
+    ghostty_terminal_free(t->terminal);
+    free(t->responses.ptr);
+    free(t);
+}
+
+void ghostty_vt_terminal_set_capture(void *ptr, ghostty_vt_capture_fn fn, void *userdata) {
+    Terminal *t = ptr;
+    t->capture = fn;
+    t->capture_userdata = userdata;
+}
+
+void ghostty_vt_terminal_set_default_colors(void *ptr, uint8_t fr, uint8_t fg, uint8_t fb, uint8_t br, uint8_t bg, uint8_t bb) {
+    Terminal *t = ptr;
+    GhosttyColorRgb foreground = {fr, fg, fb}, background = {br, bg, bb};
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_COLOR_FOREGROUND, &foreground);
+    ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_COLOR_BACKGROUND, &background);
+    t->needs_update = true;
+}
+
+int ghostty_vt_terminal_feed(void *ptr, const uint8_t *bytes, size_t len) {
+    Terminal *t = ptr;
+    /* Upstream image generations are process-global and never reused, even
+       across reset or alternate-screen storage recreation. */
+    t->needs_update = true;
+    ghostty_terminal_vt_write(t->terminal, bytes, len);
+    t->needs_update = true;
+    /* VT processing is best-effort upstream; its sticky informational error
+       cannot be cleared and must not turn every later feed into a failure. */
+    return GHOSTTY_SUCCESS;
+}
+
+int ghostty_vt_terminal_resize(void *ptr, uint16_t cols, uint16_t rows) {
+    Terminal *t = ptr;
+    if (!cols || !rows) return GHOSTTY_INVALID_VALUE;
+    if (cols == t->cols && rows == t->rows) return 0;
+    int rc = ghostty_terminal_resize(t->terminal, cols, rows, t->cell_width, t->cell_height);
+    if (!rc) { t->cols = cols; t->rows = rows; t->needs_update = true; }
+    return rc;
+}
+
+int ghostty_vt_terminal_set_cell_size(void *ptr, uint32_t width, uint32_t height) {
+    Terminal *t = ptr;
+    if (!width || !height || width > UINT32_MAX / t->cols || height > UINT32_MAX / t->rows) return GHOSTTY_INVALID_VALUE;
+    if (width == t->cell_width && height == t->cell_height) return 0;
+    int rc = ghostty_terminal_resize(t->terminal, t->cols, t->rows, width, height);
+    if (!rc) { t->cell_width = width; t->cell_height = height; t->needs_update = true; }
+    return rc;
+}
+
+static int scroll(Terminal *t, GhosttyTerminalScrollViewportTag tag, int32_t delta) {
+    GhosttyTerminalScrollViewport behavior = {.tag = tag, .value.delta = delta};
+    ghostty_terminal_scroll_viewport(t->terminal, behavior);
+    t->needs_update = true;
+    return 0;
+}
+int ghostty_vt_terminal_scroll_viewport(void *t, int32_t delta) { return scroll(t, GHOSTTY_SCROLL_VIEWPORT_DELTA, delta); }
+int ghostty_vt_terminal_scroll_viewport_top(void *t) { return scroll(t, GHOSTTY_SCROLL_VIEWPORT_TOP, 0); }
+int ghostty_vt_terminal_scroll_viewport_bottom(void *t) { return scroll(t, GHOSTTY_SCROLL_VIEWPORT_BOTTOM, 0); }
+
+bool ghostty_vt_terminal_cursor_position(void *ptr, uint16_t *col, uint16_t *row) {
+    Terminal *t = ptr;
+    if (update(t)) return false;
+    *col = t->cursor_x + 1; *row = t->cursor_y + 1;
+    return true;
+}
+
+static bool select_row(Terminal *t, uint16_t row) {
+    if (row >= t->rows || update(t)) return false;
+    if (ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_ROW_ITERATOR, &t->rows_iter)) return false;
+    for (uint32_t i = 0; i <= row; i++) if (!ghostty_render_state_row_iterator_next(t->rows_iter)) return false;
+    return ghostty_render_state_row_get(t->rows_iter, GHOSTTY_RENDER_STATE_ROW_DATA_CELLS, &t->cells_iter) == GHOSTTY_SUCCESS;
+}
+
+typedef struct { uint32_t byte_index; uint16_t column, width; } CellMapping;
+
+static ghostty_vt_bytes_t dump_row(Terminal *t, uint16_t row, bool mappings) {
+    if (!select_row(t, row)) return (ghostty_vt_bytes_t){0};
+    Buffer text = {0}, map = {0};
+    uint16_t blanks = 0;
+    for (uint32_t col = 0; col < t->cols; col++) {
+        if (!ghostty_render_state_row_cells_next(t->cells_iter)) break;
+        GhosttyCell raw = 0;
+        GhosttyCellWide wide = GHOSTTY_CELL_WIDE_NARROW;
+        ghostty_render_state_row_cells_get(t->cells_iter, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_RAW, &raw);
+        ghostty_cell_get(raw, GHOSTTY_CELL_DATA_WIDE, &wide);
+        if (wide == GHOSTTY_CELL_WIDE_SPACER_TAIL || wide == GHOSTTY_CELL_WIDE_SPACER_HEAD) continue;
+        uint8_t local[128];
+        GhosttyBuffer utf8 = {.ptr = local, .cap = sizeof(local)};
+        int rc = ghostty_render_state_row_cells_get(t->cells_iter, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_GRAPHEMES_UTF8, &utf8);
+        if (rc == GHOSTTY_OUT_OF_SPACE) {
+            utf8.ptr = malloc(utf8.len); utf8.cap = utf8.len;
+            if (!utf8.ptr) goto error;
+            rc = ghostty_render_state_row_cells_get(t->cells_iter, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_GRAPHEMES_UTF8, &utf8);
+        }
+        if (rc) { if (utf8.ptr != local) free(utf8.ptr); goto error; }
+        if (utf8.len == 0) { blanks++; continue; }
+        for (uint32_t b = 0; b < blanks; b++) {
+            CellMapping cell = {(uint32_t)text.len, (uint16_t)(col - blanks + b), 1};
+            if (!append(&map, &cell, sizeof(cell)) || !append(&text, " ", 1)) {
+                if (utf8.ptr != local) free(utf8.ptr); goto error;
+            }
+        }
+        blanks = 0;
+        CellMapping cell = {(uint32_t)text.len, (uint16_t)col, wide == GHOSTTY_CELL_WIDE_WIDE ? 2 : 1};
+        bool ok = append(&map, &cell, sizeof(cell)) && append(&text, utf8.ptr, utf8.len);
+        if (utf8.ptr != local) free(utf8.ptr);
+        if (!ok) goto error;
+    }
+    if (mappings) { free(text.ptr); return finish(map); }
+    free(map.ptr); return finish(text);
+error:
+    free(text.ptr); free(map.ptr); return (ghostty_vt_bytes_t){0};
+}
+
+ghostty_vt_bytes_t ghostty_vt_terminal_dump_viewport_row(void *ptr, uint16_t row) { return dump_row(ptr, row, false); }
+ghostty_vt_bytes_t ghostty_vt_terminal_dump_viewport_row_cells(void *ptr, uint16_t row) { return dump_row(ptr, row, true); }
+ghostty_vt_bytes_t ghostty_vt_terminal_dump_viewport(void *ptr) {
+    Terminal *t = ptr;
+    Buffer all = {0};
+    for (uint32_t row = 0; row < t->rows; row++) {
+        ghostty_vt_bytes_t part = dump_row(t, (uint16_t)row, false);
+        if (!part.ptr) return fail(all);
+        bool ok = append(&all, part.ptr, part.len) && (row + 1 == t->rows || append(&all, "\n", 1));
+        ghostty_vt_bytes_free(part);
+        if (!ok) return fail(all);
+    }
+    while (all.len && all.ptr[all.len - 1] == '\n') all.len--;
+    return finish(all);
+}
+
+static ghostty_vt_cell_style_t cell_style(Terminal *t, GhosttyColorRgb default_fg, GhosttyColorRgb default_bg) {
+    GhosttyStyle style = GHOSTTY_INIT_SIZED(GhosttyStyle);
+    ghostty_render_state_row_cells_get(t->cells_iter, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_STYLE, &style);
+    GhosttyColorRgb fg = default_fg, bg = default_bg;
+    ghostty_render_state_row_cells_get(t->cells_iter, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_FG_COLOR, &fg);
+    bool explicit_bg = ghostty_render_state_row_cells_get(t->cells_iter, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_BG_COLOR, &bg) == GHOSTTY_SUCCESS;
+    uint8_t flags = (style.inverse ? 1 : 0) | (style.bold ? 2 : 0) | (style.italic ? 4 : 0) |
+        (style.underline ? 8 : 0) | (style.faint ? 16 : 0) | (style.invisible ? 32 : 0) |
+        (style.strikethrough ? 64 : 0) | (explicit_bg ? 128 : 0);
+    if (style.inverse) { GhosttyColorRgb temp = fg; fg = bg; bg = temp; }
+    if (style.invisible) fg = bg;
+    return (ghostty_vt_cell_style_t){fg.r, fg.g, fg.b, bg.r, bg.g, bg.b, flags, 0};
+}
+
+typedef struct { uint16_t start, end; ghostty_vt_cell_style_t style; } StyleRun;
+static ghostty_vt_bytes_t dump_styles(Terminal *t, uint16_t row, bool runs) {
+    if (!select_row(t, row)) return (ghostty_vt_bytes_t){0};
+    GhosttyColorRgb fg, bg;
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_COLOR_FOREGROUND, &fg);
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_COLOR_BACKGROUND, &bg);
+    Buffer out = {0};
+    StyleRun run = {0};
+    for (uint32_t col = 0; col < t->cols; col++) {
+        if (!ghostty_render_state_row_cells_next(t->cells_iter)) break;
+        ghostty_vt_cell_style_t style = cell_style(t, fg, bg);
+        if (!runs) { if (!append(&out, &style, sizeof(style))) return fail(out); continue; }
+        if (!run.start) run = (StyleRun){(uint16_t)(col + 1), (uint16_t)(col + 1), style};
+        else if (memcmp(&run.style, &style, sizeof(style)) != 0) {
+            if (!append(&out, &run, sizeof(run))) return fail(out);
+            run = (StyleRun){(uint16_t)(col + 1), (uint16_t)(col + 1), style};
+        } else run.end = (uint16_t)(col + 1);
+    }
+    if (runs && run.start && !append(&out, &run, sizeof(run))) return fail(out);
+    return finish(out);
+}
+ghostty_vt_bytes_t ghostty_vt_terminal_dump_viewport_row_cell_styles(void *t, uint16_t row) { return dump_styles(t, row, false); }
+ghostty_vt_bytes_t ghostty_vt_terminal_dump_viewport_row_style_runs(void *t, uint16_t row) { return dump_styles(t, row, true); }
+
+ghostty_vt_bytes_t ghostty_vt_terminal_take_dirty_viewport_rows(void *ptr, uint16_t count) {
+    Terminal *t = ptr;
+    if (update(t)) return (ghostty_vt_bytes_t){0};
+    GhosttyRenderStateDirty dirty;
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_DIRTY, &dirty);
+    ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_ROW_ITERATOR, &t->rows_iter);
+    Buffer out = {0};
+    uint32_t y = 0;
+    while (ghostty_render_state_row_iterator_next(t->rows_iter)) {
+        bool row_dirty = false;
+        ghostty_render_state_row_get(t->rows_iter, GHOSTTY_RENDER_STATE_ROW_DATA_DIRTY, &row_dirty);
+        if (y < count && (row_dirty || dirty == GHOSTTY_RENDER_STATE_DIRTY_FULL)) {
+            uint8_t bytes[2] = {(uint8_t)y, (uint8_t)(y >> 8)};
+            if (!append(&out, bytes, 2)) return fail(out);
+        }
+        y++;
+    }
+    ghostty_render_state_clean(t->state);
+    return finish(out);
+}
+
+int32_t ghostty_vt_terminal_take_viewport_scroll_delta(void *ptr) {
+    Terminal *t = ptr;
+    update(t);
+    int64_t delta = t->has_scroll ? (int64_t)t->scroll_offset - (int64_t)t->previous_scroll : 0;
+    t->has_scroll = true; t->previous_scroll = t->scroll_offset;
+    return delta > INT32_MAX ? INT32_MAX : delta < INT32_MIN ? INT32_MIN : (int32_t)delta;
+}
+
+ghostty_vt_bytes_t ghostty_vt_terminal_hyperlink_at(void *ptr, uint16_t col, uint16_t row) {
+    Terminal *t = ptr;
+    if (!col || !row) return (ghostty_vt_bytes_t){0};
+    GhosttyPoint point = {.tag = GHOSTTY_POINT_TAG_VIEWPORT, .value.coordinate = {.x = col - 1, .y = row - 1}};
+    GhosttyGridRef ref;
+    if (ghostty_terminal_grid_ref(t->terminal, point, &ref)) return (ghostty_vt_bytes_t){0};
+    size_t len = 0;
+    int rc = ghostty_grid_ref_hyperlink_uri(&ref, NULL, 0, &len);
+    if (rc != GHOSTTY_OUT_OF_SPACE && rc != GHOSTTY_SUCCESS) return (ghostty_vt_bytes_t){0};
+    uint8_t *buf = malloc(len ? len : 1);
+    if (!buf) return (ghostty_vt_bytes_t){0};
+    if (ghostty_grid_ref_hyperlink_uri(&ref, buf, len, &len)) { free(buf); return (ghostty_vt_bytes_t){0}; }
+    return (ghostty_vt_bytes_t){buf, len};
+}
+
+ghostty_vt_bytes_t ghostty_vt_terminal_take_responses(void *ptr) {
+    Terminal *t = ptr;
+    Buffer response = t->responses;
+    t->responses = (Buffer){0};
+    return finish(response);
+}
+
+int ghostty_vt_terminal_tick(void *ptr, uint64_t now_ms) {
+    Terminal *t = ptr;
+    if (!now_ms) now_ms = monotonic_ms();
+    if (t->held && now_ms >= t->hold_deadline) {
+        GhosttyTerminalModeConfig mode = {.mode = GHOSTTY_MODE_SYNC_OUTPUT, .value = false};
+        ghostty_terminal_set(t->terminal, GHOSTTY_TERMINAL_OPT_MODE, &mode);
+        t->held = false; t->hold_deadline = 0; t->needs_update = true;
+    }
+    t->animation_deadline = 0;
+    if (!t->held) {
+        GhosttyKittyGraphics graphics = NULL;
+        if (!ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_KITTY_GRAPHICS, &graphics)) {
+            uint64_t next = 0;
+            int rc = ghostty_kitty_graphics_animation_tick(graphics, now_ms, &next);
+            if (rc == GHOSTTY_SUCCESS) {
+                t->animation_deadline = next > now_ms + 8 ? next : now_ms + 8;
+                /* A SUCCESS does not mean this tick changed pixels. */
+                t->needs_update = true;
+            } else if (rc != GHOSTTY_NO_VALUE) {
+                return rc;
+            }
+        }
+    }
+    return update(t);
+}
+uint64_t ghostty_vt_terminal_deadline(void *ptr) {
+    Terminal *t = ptr;
+    uint64_t deadline = t->held ? t->hold_deadline : t->animation_deadline;
+    if (!deadline) return UINT64_MAX;
+    return deadline;
+}
+uint64_t ghostty_vt_monotonic_ms(void) { return monotonic_ms(); }
+bool ghostty_vt_terminal_held(void *ptr) { return ((Terminal *)ptr)->held; }
+uint64_t ghostty_vt_terminal_epoch(void *ptr) { return ((Terminal *)ptr)->epoch; }
+int ghostty_vt_terminal_images_begin(void *ptr) {
+    Terminal *t = ptr;
+    int rc = update(t);
+    if (rc) return rc;
+    return ghostty_render_state_get(t->state, GHOSTTY_RENDER_STATE_DATA_IMAGE_ITERATOR, &t->images_iter);
+}
+bool ghostty_vt_terminal_images_next(void *ptr, ghostty_vt_image_placement_t *out) {
+    Terminal *t = ptr;
+    if (!ghostty_render_state_image_iterator_next(t->images_iter)) return false;
+    memset(out, 0, sizeof(*out));
+    const GhosttyRenderStateImageData keys[] = {
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_IMAGE_ID, GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_PLACEMENT_ID,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_IMAGE_GENERATION, GHOSTTY_RENDER_STATE_IMAGE_DATA_LAYER,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_Z, GHOSTTY_RENDER_STATE_IMAGE_DATA_VIEWPORT_COL,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_VIEWPORT_ROW, GHOSTTY_RENDER_STATE_IMAGE_DATA_CELL_OFFSET_X,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_CELL_OFFSET_Y, GHOSTTY_RENDER_STATE_IMAGE_DATA_PIXEL_WIDTH,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_PIXEL_HEIGHT, GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_X,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_Y, GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_WIDTH,
+        GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_HEIGHT};
+    void *values[] = {&out->image_id, &out->placement_id, &out->generation, &out->layer, &out->z,
+        &out->viewport_col, &out->viewport_row, &out->offset_x, &out->offset_y, &out->width, &out->height,
+        &out->source_x, &out->source_y, &out->source_width, &out->source_height};
+    return ghostty_render_state_image_get_multi(t->images_iter, sizeof(keys) / sizeof(keys[0]), keys, values, NULL) == GHOSTTY_SUCCESS;
+}
+int ghostty_vt_terminal_image_data(void *ptr, uint32_t id, uint32_t *width, uint32_t *height, int32_t *format, const uint8_t **data, size_t *len) {
+    Terminal *t = ptr;
+    GhosttyKittyGraphics graphics = NULL;
+    int rc = ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_KITTY_GRAPHICS, &graphics);
+    if (rc) return rc;
+    GhosttyKittyGraphicsImage image = ghostty_kitty_graphics_image(graphics, id);
+    if (!image) return GHOSTTY_NO_VALUE;
+    const GhosttyKittyGraphicsImageData keys[] = {GHOSTTY_KITTY_IMAGE_DATA_WIDTH, GHOSTTY_KITTY_IMAGE_DATA_HEIGHT,
+        GHOSTTY_KITTY_IMAGE_DATA_FORMAT, GHOSTTY_KITTY_IMAGE_DATA_DATA_PTR, GHOSTTY_KITTY_IMAGE_DATA_DATA_LEN};
+    void *values[] = {width, height, format, data, len};
+    return ghostty_kitty_graphics_image_get_multi(image, 5, keys, values, NULL);
+}
+
+ghostty_vt_bytes_t ghostty_vt_terminal_title(void *ptr) {
+    Terminal *t = ptr;
+    GhosttyString title = {0};
+    if (ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_TITLE, &title)) return (ghostty_vt_bytes_t){0};
+    Buffer out = {0};
+    if (!append(&out, title.ptr, title.len)) return fail(out);
+    return finish(out);
+}
+
+int ghostty_vt_terminal_mode(void *ptr, uint16_t mode, bool ansi, bool *out) {
+    Terminal *t = ptr;
+    GhosttyTerminalModeConfig config = {.mode = ghostty_mode_new(mode, ansi)};
+    int rc = ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_MODE, &config);
+    if (!rc) *out = config.value;
+    return rc;
+}
+
+int ghostty_vt_terminal_mouse_tracking(void *ptr, bool *out) {
+    Terminal *t = ptr;
+    return ghostty_terminal_get(t->terminal, GHOSTTY_TERMINAL_DATA_MOUSE_TRACKING, out);
+}
+
+ghostty_vt_bytes_t ghostty_vt_encode_key_named(const uint8_t *name, size_t len, uint16_t modifiers) {
+    GhosttyKey key = GHOSTTY_KEY_UNIDENTIFIED;
+#define KEY(n, value) if (len == sizeof(n) - 1 && memcmp(name, n, len) == 0) key = GHOSTTY_KEY_##value
+    KEY("up", ARROW_UP); KEY("down", ARROW_DOWN); KEY("left", ARROW_LEFT); KEY("right", ARROW_RIGHT);
+    KEY("home", HOME); KEY("end", END); KEY("insert", INSERT); KEY("delete", DELETE);
+    KEY("pageup", PAGE_UP); KEY("page_up", PAGE_UP); KEY("page-up", PAGE_UP);
+    KEY("pagedown", PAGE_DOWN); KEY("page_down", PAGE_DOWN); KEY("page-down", PAGE_DOWN);
+    KEY("backspace", BACKSPACE); KEY("enter", ENTER); KEY("tab", TAB); KEY("escape", ESCAPE);
+#undef KEY
+    if (len >= 2 && len <= 3 && name[0] == 'f') {
+        unsigned n = 0;
+        for (size_t i = 1; i < len; i++) { if (name[i] < '0' || name[i] > '9') return (ghostty_vt_bytes_t){0}; n = n * 10 + name[i] - '0'; }
+        if (n >= 1 && n <= 12) key = GHOSTTY_KEY_F1 + n - 1;
+    }
+    if (key == GHOSTTY_KEY_UNIDENTIFIED) return (ghostty_vt_bytes_t){0};
+    GhosttyKeyEncoder encoder = NULL;
+    GhosttyKeyEvent event = NULL;
+    if (ghostty_key_encoder_new(NULL, &encoder) || ghostty_key_event_new(NULL, &event)) {
+        ghostty_key_encoder_free(encoder); ghostty_key_event_free(event); return (ghostty_vt_bytes_t){0};
+    }
+    bool alt = true;
+    ghostty_key_encoder_setopt(encoder, GHOSTTY_KEY_ENCODER_OPT_ALT_ESC_PREFIX, &alt);
+    ghostty_key_event_set_action(event, GHOSTTY_KEY_ACTION_PRESS);
+    ghostty_key_event_set_key(event, key);
+    ghostty_key_event_set_mods(event, modifiers);
+    char buffer[128]; size_t size = 0;
+    int rc = ghostty_key_encoder_encode(encoder, event, buffer, sizeof(buffer), &size);
+    ghostty_key_encoder_free(encoder); ghostty_key_event_free(event);
+    Buffer out = {0};
+    if (rc || !append(&out, buffer, size)) return fail(out);
+    return finish(out);
+}
+void ghostty_vt_bytes_free(ghostty_vt_bytes_t bytes) { free((void *)bytes.ptr); }
