+use ghostty_vt::{Rgb, Terminal};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+const RED: &[u8] = b"\x1b_Ga=T,f=32,i=1,p=1,s=1,v=1,c=1,r=1,C=1;/wAA/w==\x1b\\";
+
+fn terminal() -> Terminal {
+    let mut t = Terminal::new(12, 6).unwrap();
+    t.set_cell_size(10, 20).unwrap();
+    t
+}
+
+#[test]
+fn raw_image_query_delete_and_arc_reuse() {
+    let mut t = terminal();
+    t.feed(b"\x1b_Ga=q,f=24,i=99,s=1,v=1;AAAA\x1b\\").unwrap();
+    assert_eq!(t.take_responses(), b"\x1b_Gi=99;OK\x1b\\");
+    t.feed(RED).unwrap();
+    let a = t.images().unwrap().remove(0);
+    assert_eq!(a.image.rgba, [255, 0, 0, 255]);
+    assert_eq!((a.width, a.height, a.layer), (10, 20, 2));
+    t.feed(b"text\x1b[3;2H\x1b_Ga=p,i=1,p=2,c=2,r=1,C=1\x1b\\")
+        .unwrap();
+    let placements = t.images().unwrap();
+    assert_eq!(placements.len(), 2);
+    assert!(placements.iter().all(|p| Arc::ptr_eq(&a.image, &p.image)));
+    assert!(placements.iter().all(|p| p.generation == a.generation));
+    t.feed(b"\x1b_Ga=d,d=I,i=1\x1b\\").unwrap();
+    assert!(t.images().unwrap().is_empty());
+}
+
+#[test]
+fn png_decoder_preserves_actual_color_and_alpha() {
+    let mut t = terminal();
+    t.feed(b"\x1b_Ga=T,f=100,i=2,C=1;iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAAD0lEQVR4nGP4z8DwHwgbABB5A359Y87XAAAAAElFTkSuQmCC\x1b\\").unwrap();
+    let p = t.images().unwrap().remove(0);
+    assert_eq!((p.image.width, p.image.height), (2, 1));
+    assert_eq!(p.image.rgba, [255, 0, 0, 255, 0, 255, 0, 128]);
+}
+
+#[test]
+fn malformed_png_is_rejected_without_breaking_text() {
+    let mut t = terminal();
+    t.feed(b"\x1b_Ga=T,f=100,i=2;Ym9ndXM=\x1b\\hello").unwrap();
+    assert!(t.images().unwrap().is_empty());
+    assert!(String::from_utf8_lossy(&t.take_responses()).contains("EINVAL"));
+    assert_eq!(t.dump_viewport_row(0).unwrap(), "hello");
+}
+
+#[test]
+fn pending_chunk_is_not_negatively_cached() {
+    let mut t = terminal();
+    t.feed(b"\x1b_Ga=T,f=32,i=1,s=1,v=1,C=1,m=1;/wAA\x1b\\")
+        .unwrap();
+    assert!(t.images().unwrap().is_empty());
+    t.feed(b"\x1b_Gm=0;/w==\x1b\\").unwrap();
+    assert_eq!(t.images().unwrap()[0].image.rgba, [255, 0, 0, 255]);
+}
+
+#[test]
+fn layers_crops_and_relative_positions_come_from_render_state() {
+    let mut t = terminal();
+    t.feed(b"\x1b_Ga=t,f=24,i=1,s=2,v=2;/wAAAP8AAAD/////\x1b\\")
+        .unwrap();
+    t.feed(b"\x1b[2;3H\x1b_Ga=p,i=1,p=1,c=3,r=2,x=1,y=0,w=1,h=2,X=4,Y=3,z=-5,C=1\x1b\\")
+        .unwrap();
+    t.feed(b"\x1b_Ga=p,i=1,p=2,P=1,Q=1,H=2,V=1,c=1,r=1,z=-2147483648,C=1\x1b\\")
+        .unwrap();
+    let placements = t.images().unwrap();
+    let p = placements.iter().find(|p| p.placement_id == 1).unwrap();
+    assert_eq!(
+        (p.viewport_col, p.viewport_row, p.layer, p.z),
+        (2, 1, 1, -5)
+    );
+    assert_eq!((p.offset_x, p.offset_y), (4, 3));
+    assert_eq!(
+        (p.source_x, p.source_y, p.source_width, p.source_height),
+        (1, 0, 1, 2)
+    );
+    let relative = placements.iter().find(|p| p.placement_id == 2).unwrap();
+    assert_eq!(
+        (relative.viewport_col, relative.viewport_row, relative.layer),
+        (4, 2, 0)
+    );
+}
