+use ghostty_vt::{ImageData, ImagePlacement};
+use gpui::{App, Bounds, ContentMask, Corners, Pixels, RenderImage, Window, point, px, size};
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+
+#[derive(Default)]
+pub(super) struct ImageCache {
+    textures: HashMap<TextureKey, Arc<RenderImage>>,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct TextureKey {
+    image_id: u32,
+    generation: u64,
+    crop: (u32, u32, u32, u32),
+}
+
+impl TextureKey {
+    fn new(p: &ImagePlacement) -> Self {
+        Self {
+            image_id: p.image_id,
+            generation: p.generation,
+            crop: (p.source_x, p.source_y, p.source_width, p.source_height),
+        }
+    }
+
+    fn byte_len(self) -> Option<usize> {
+        (self.crop.2 as usize)
+            .checked_add(2)?
+            .checked_mul((self.crop.3 as usize).checked_add(2)?)?
+            .checked_mul(4)
+    }
+}
+
+pub(super) struct ImageDraw {
+    layer: u8,
+    bounds: Bounds<Pixels>,
+    clip: Bounds<Pixels>,
+    texture: Arc<RenderImage>,
+}
+
+impl ImageCache {
+    pub(super) fn prepare(
+        &mut self,
+        mut placements: Vec<ImagePlacement>,
+        viewport: Bounds<Pixels>,
+        cell_metrics: (f32, f32),
+        scale_factor: f32,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Vec<ImageDraw> {
+        // Kitty orders equal-z placements by image ID, then placement ID. The
+        // stable sort preserves upstream order for pieces of a virtual image.
+        placements.sort_by_key(|p| (p.layer, p.z, p.image_id, p.placement_id));
+        let mut live = HashSet::new();
+        let mut texture_bytes = 0usize;
+        let visible: Vec<_> = placements
+            .into_iter()
+            .filter_map(|placement| {
+                let (bounds, clip) =
+                    image_bounds(&placement, viewport, cell_metrics, scale_factor)?;
+                let key = TextureKey::new(&placement);
+                if !live.contains(&key) {
+                    let bytes = key.byte_len()?;
+                    if texture_bytes.saturating_add(bytes) > 64 * 1024 * 1024 {
+                        return None;
+                    }
+                    texture_bytes += bytes;
+                    live.insert(key);
+                }
+                Some((placement, bounds, clip))
+            })
+            .collect();
+        // Keep only generations visible in this view. Removing an Arc does not
+        // free the GPUI atlas entry, so eviction must reach every window atlas.
+        self.textures.retain(|key, texture| {
+            if live.contains(key) {
+                true
+            } else {
+                cx.drop_image(texture.clone(), Some(window));
+                false
+            }
+        });
+        visible
+            .into_iter()
+            .filter_map(|(placement, bounds, clip)| {
+                let key = TextureKey::new(&placement);
+                let texture = if let Some(texture) = self.textures.get(&key) {
+                    texture.clone()
+                } else {
+                    let Some(texture) = render_image(&placement.image, key.crop) else {
+                        eprintln!(
+                            "Invalid Kitty image dimensions for image {}",
+                            placement.image_id
+                        );
+                        return None;
+                    };
+                    let texture = Arc::new(texture);
+                    self.textures.insert(key, texture.clone());
+                    texture
+                };
+                Some(ImageDraw {
+                    layer: placement.layer,
+                    bounds,
+                    clip,
+                    texture,
+                })
+            })
+            .collect()
+    }
+
+    pub(super) fn clear(&mut self, cx: &mut App) {
+        for (_, texture) in self.textures.drain() {
+            cx.drop_image(texture, None);
+        }
+    }
+}
+
+impl ImageDraw {
+    pub(super) fn paint_layer(images: &[Self], layer: u8, window: &mut Window) {
+        for image in images.iter().filter(|image| image.layer == layer) {
+            // Separate overlapping placements because the scene sorts sprites
+            // by atlas tile within a layer, which would otherwise reorder z.
+            window.paint_layer(image.clip, |window| {
+                window.with_content_mask(Some(ContentMask { bounds: image.clip }), |window| {
+                    if let Err(error) = window.paint_image(
+                        image.bounds,
+                        Corners::default(),
+                        image.texture.clone(),
+                        0,
+                        false,
+                    ) {
+                        eprintln!("Paint Kitty image: {error}");
+                    }
+                });
+            });
+        }
+    }
+}
+
+fn render_image(image: &ImageData, crop: (u32, u32, u32, u32)) -> Option<RenderImage> {
+    let (x, y, width, height) = crop;
+    if width == 0
+        || height == 0
+        || x.checked_add(width)? > image.width
+        || y.checked_add(height)? > image.height
+    {
+        return None;
+    }
+    let expected = (image.width as usize)
+        .checked_mul(image.height as usize)?
+        .checked_mul(4)?;
+    if image.rgba.len() != expected {
+        return None;
+    }
+    let padded_width = width.checked_add(2)?;
+    let padded_height = height.checked_add(2)?;
+    let length = (padded_width as usize)
+        .checked_mul(padded_height as usize)?
+        .checked_mul(4)?;
+    if length > 64 * 1024 * 1024 {
+        return None;
+    }
+    // GPUI samples atlas tiles linearly without clamping to their boundaries.
+    // Extrude the crop's edges so scaling cannot blend adjacent pixels or tiles.
+    let mut bgra = Vec::with_capacity(length);
+    for row in 0..padded_height {
+        let source_y = y + row.saturating_sub(1).min(height - 1);
+        for column in 0..padded_width {
+            let source_x = x + column.saturating_sub(1).min(width - 1);
+            let offset = (source_y as usize * image.width as usize + source_x as usize) * 4;
+            let pixel = &image.rgba[offset..offset + 4];
+            bgra.extend_from_slice(&[pixel[2], pixel[1], pixel[0], pixel[3]]);
+        }
+    }
+    let buffer = image::RgbaImage::from_raw(padded_width, padded_height, bgra)?;
+    Some(RenderImage::new([image::Frame::new(buffer)]))
+}
+
+fn image_bounds(
+    placement: &ImagePlacement,
+    viewport: Bounds<Pixels>,
+    cell_metrics: (f32, f32),
+    scale_factor: f32,
+) -> Option<(Bounds<Pixels>, Bounds<Pixels>)> {
+    if placement.layer > 2
+        || placement.width == 0
+        || placement.height == 0
+        || placement.source_width == 0
+        || placement.source_height == 0
+        || placement.image.width == 0
+        || placement.image.height == 0
+        || !scale_factor.is_finite()
+        || scale_factor <= 0.0
+        || !cell_metrics.0.is_finite()
+        || !cell_metrics.1.is_finite()
+        || cell_metrics.0 <= 0.0
+        || cell_metrics.1 <= 0.0
+        || placement.source_x.checked_add(placement.source_width)? > placement.image.width
+        || placement.source_y.checked_add(placement.source_height)? > placement.image.height
+    {
+        return None;
+    }
+    let destination = Bounds::new(
+        point(
+            viewport.left()
+                + px(placement.viewport_col as f32 * cell_metrics.0
+                    + placement.offset_x as f32 / scale_factor),
+            viewport.top()
+                + px(placement.viewport_row as f32 * cell_metrics.1
+                    + placement.offset_y as f32 / scale_factor),
+        ),
+        size(
+            px(placement.width as f32 / scale_factor),
+            px(placement.height as f32 / scale_factor),
+        ),
+    );
+    let clip = destination.intersect(&viewport);
+    if clip.is_empty() {
+        return None;
+    }
+    // The one-pixel extruded border falls outside the destination mask.
+    let scale_x = destination.size.width / placement.source_width as f32;
+    let scale_y = destination.size.height / placement.source_height as f32;
+    let bounds = Bounds::new(
+        point(destination.left() - scale_x, destination.top() - scale_y),
+        size(
+            scale_x * (placement.source_width as f32 + 2.0),
+            scale_y * (placement.source_height as f32 + 2.0),
+        ),
+    );
+    Some((bounds, clip))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn placement() -> ImagePlacement {
+        ImagePlacement {
+            image_id: 1,
+            placement_id: 1,
+            generation: 1,
+            layer: 1,
+            z: -1,
+            viewport_col: 2,
+            viewport_row: -1,
+            offset_x: 4,
+            offset_y: 8,
+            width: 80,
+            height: 80,
+            source_x: 20,
+            source_y: 10,
+            source_width: 40,
+            source_height: 20,
+            image: Arc::new(ImageData {
+                width: 100,
+                height: 60,
+                rgba: Vec::new(),
+            }),
+        }
+    }
+
+    #[test]
+    fn rgba_is_uploaded_as_bgra_with_alpha_unchanged() {
+        let source = ImageData {
+            width: 2,
+            height: 1,
+            rgba: vec![255, 32, 0, 128, 0, 64, 255, 255],
+        };
+        let image = render_image(&source, (0, 0, 2, 1)).unwrap();
+        let padded_row = [
+            0, 32, 255, 128, 0, 32, 255, 128, 255, 64, 0, 255, 255, 64, 0, 255,
+        ];
+        assert_eq!(image.as_bytes(0).unwrap(), padded_row.repeat(3));
+        let crop = render_image(&source, (1, 0, 1, 1)).unwrap();
+        assert_eq!(crop.as_bytes(0).unwrap(), [255, 64, 0, 255].repeat(9));
+        assert_eq!(source.rgba, [255, 32, 0, 128, 0, 64, 255, 255]);
+        assert!(
+            render_image(
+                &ImageData {
+                    width: 0,
+                    height: 1,
+                    rgba: Vec::new()
+                },
+                (0, 0, 0, 1)
+            )
+            .is_none()
+        );
+        assert!(
+            render_image(
+                &ImageData {
+                    width: 2,
+                    height: 1,
+                    rgba: vec![0; 4]
+                },
+                (0, 0, 2, 1)
+            )
+            .is_none()
+        );
+    }
+
+    #[test]
+    fn cropping_uses_physical_pixels_and_clips_negative_viewport_rows() {
+        let viewport = Bounds::new(point(px(10.0), px(20.0)), size(px(200.0), px(100.0)));
+        let (bounds, clip) = image_bounds(&placement(), viewport, (10.0, 20.0), 2.0).unwrap();
+        assert_eq!(
+            bounds,
+            Bounds::new(point(px(31.0), px(2.0)), size(px(42.0), px(44.0)))
+        );
+        assert_eq!(
+            clip,
+            Bounds::new(point(px(32.0), px(20.0)), size(px(40.0), px(24.0)))
+        );
+    }
+
+    #[test]
+    fn invalid_or_offscreen_placements_do_not_allocate_textures() {
+        let viewport = Bounds::new(point(px(0.0), px(0.0)), size(px(100.0), px(100.0)));
+        for index in 0..6 {
+            let mut placement = placement();
